# Coolify API Credentials
COOLIFY_API_URL=http://<coolify-ip-or-domain>:8000/api/v1
COOLIFY_API_TOKEN=<your-coolify-sanctum-token>

# Deployment Targets
TARGET_PROJECT_UUID=<project-uuid>
TARGET_ENVIRONMENT_NAME=production
TARGET_SERVER_UUID=<server-uuid>
TARGET_DESTINATION_UUID=<destination-uuid>

# Open WebUI Config
OPENWEBUI_BASE_URL=http://<openwebui-ip>:8088
OPENWEBUI_ADMIN_TOKEN=<openwebui-jwt-admin-token>

# PocketBase Admin Credentials
PB_ADMIN_EMAIL=admin@pocketbase.local
PB_ADMIN_PASSWORD=<pocketbase-admin-password>

# LDAP / Active Directory Configuration
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=DC=aapico,DC=com
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=person)
LDAP_DOMAIN=aapico.com
